{{/* ~/.ssh/config — managed by myplace. See ADR-0022 and the managed-setup guide.

  The full, host-bearing config (server IPs etc.) is NOT committed in plaintext:
  it lives age-encrypted in this repo (private_config.d/encrypted_private_hosts.age)
  and is decrypted at apply time with the machine's age key
  (~/.config/chezmoi/key.txt, fetched once from 1Password by
  run_once_before_fetch-age-key.sh). Desktops get it via the Include below;
  servers render just the non-secret global defaults — the encrypted file is out
  of scope for them entirely (.chezmoiignore), so they never need the key.

  To edit the host list: decrypt → edit → re-encrypt with chezmoi; never paste a
  host block into this file. Recipe: docs/workflows/edit-ssh-config.md. To change
  the shared defaults every machine gets, edit the `Host *` block below. */ -}}
{{- if ne .profile "server" }}
# Host list (secret; age-decrypted to ~/.ssh/config.d/hosts — desktops only).
# Must precede Host * — ssh keeps the first value it obtains for an option.
Include config.d/hosts
{{ end }}
# --- global defaults (managed by myplace; every machine) ---
Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
    VisualHostKey yes
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- end }}
