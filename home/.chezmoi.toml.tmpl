{{/* Machine identity, collected once on `chezmoi init` and stored in ~/.config/chezmoi/chezmoi.toml */}}
{{/* Headless/agent init can pre-answer the prompts, e.g.:
     --promptChoice profile=server --promptString gitEmail=you@work.com */}}
{{/* prompt strings match the data keys so `--promptString gitEmail=…` resolves
     (chezmoi matches --promptString by prompt text, not by the data key). */}}
{{- $profile := promptChoiceOnce . "profile" "profile" (list "personal-mac" "personal-linux" "work-mac" "server") -}}
{{- $gitName := promptStringOnce . "gitName" "gitName" "Mike Valstar" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "gitEmail" "mike@valstar.dev" -}}

{{/* age encryption for secret-bearing dotfiles (ADR-0022). The identity is a
     per-fleet key fetched once from 1Password by run_once_before_fetch-age-key;
     the recipient is its public half (not secret). Configured on every profile —
     servers never decrypt anything (.chezmoiignore takes the encrypted targets
     out of scope there), so a missing key file is harmless on them. */}}
encryption = "age"

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    recipient = "age1ph0y4eyan8l6lwg2dkjtzj7l52z5nrsz0g0qdqvrpc4e3znctgnqwyz4fa"

[data]
    profile = {{ $profile | quote }}
    gitName = {{ $gitName | quote }}
    gitEmail = {{ $gitEmail | quote }}
    push = {{ ne $profile "server" }}
    # Machines share by default; per-machine differences (e.g. a work email)
    # are answered at install time, not branched in templates.
    # Work machines can push shared config; servers consume by default.

[git]
    autoCommit = false
    autoPush = false
